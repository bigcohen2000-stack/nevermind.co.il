# Public (safe to expose in the browser)
NEXT_PUBLIC_SITE_URL=https://nevermind.co.il
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# Digits with country code (no +). Used for WhatsApp + SMS contact deep links.
NEXT_PUBLIC_WHATSAPP_NUMBER=972555634035

# Server only (never commit real values)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
YOUTUBE_API_KEY=your_youtube_data_api_v3_key
CRON_SECRET=generate_with_openssl_rand_hex_32
# Optional separate Studio unlock secret (falls back to CRON_SECRET).
# openssl rand -hex 32
STUDIO_SECRET=
# Bookmark unlock URL: https://nevermind.co.il/{STUDIO_GATE_SLUG}
# Default nm-ops. If you change this, also add the path to src/middleware.ts matcher.
STUDIO_GATE_SLUG=nm-ops
# Require Cloudflare Access JWT before Studio gate/cookie (see docs/studio-cloudflare-access.md).
# Set to 1 only after Access app is live on nevermind.co.il for /nm-ops* and /studio*.
STUDIO_REQUIRE_CF_ACCESS=
# Comma-separated emails allowed when STUDIO_REQUIRE_CF_ACCESS=1
STUDIO_ALLOWED_EMAILS=bigcohen2000@gmail.com
# Cryptographic JWT verify (recommended with REQUIRE=1).
# Team domain: Zero Trust → Settings → Team domain (e.g. yourteam.cloudflareaccess.com)
# AUD: Access application → Overview → Application Audience (AUD) Tag
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=

# Phone SMS OTP login (account auth) is NOT configured via Next.js env.
# Prefer Google OAuth + email magic link (free). Phone needs a paid SMS provider.
# Enable in Supabase Dashboard for THIS project only:
#   Google: Authentication → Providers → Google → Client ID + Secret from Google Cloud
#   Phone (optional/paid): Authentication → Providers → Phone → Twilio / MessageBird / Vonage
#   Authentication → URL Configuration → add https://nevermind.co.il/** and localhost redirect URLs
# Contact "SMS רגיל" CTAs (kosher phones) only need NEXT_PUBLIC_WHATSAPP_NUMBER above.

# YouTube sync sources (comma-separated)
YOUTUBE_CHANNEL_IDS=UC3GSyQxkCHsXInanjQfG4RA
# Always walk these playlists (in addition to channel uploads + auto-discovered
# public playlists). Public depth / level 3 talks live here — NOT force-gated.
YOUTUBE_PLAYLIST_IDS=PLwkkuwNJAgMgmnoHcwBo6WTAarQVvDRQ7
# Club / unlisted content:
# Channel uploads (API key) only sees PUBLIC videos. Unlisted club items are
# pulled from public playlists on the channel, or from IDs below.
# On ingest, privacyStatus "unlisted" auto-sets is_unlisted + is_gated (club).
# GATED_PLAYLIST_IDS: every video from these playlists is force-gated.
# When YouTube Studio has unlisted playlist "השם לא משנה - המועדון", paste its
# PL… id here and re-run: npm run videos:sync
# Until then leave empty; club seeds use the ID lists below.
GATED_PLAYLIST_IDS=
YOUTUBE_UNLISTED_VIDEO_IDS=Ap_YtCBV4cI,mlBIRDAVZNM,Kxx_Sh84zVY,HcJIng2-4ps,YnAhidIuoJk,sjqu-dkLAmc,0xJFsfLMR5w,-9yya_KEBCU,5Ie1HomzqwQ,39c9tXIjuzU,CfB-Qz0G56k
YOUTUBE_GATED_VIDEO_IDS=Ap_YtCBV4cI,mlBIRDAVZNM,Kxx_Sh84zVY,HcJIng2-4ps,YnAhidIuoJk,sjqu-dkLAmc,0xJFsfLMR5w,-9yya_KEBCU,5Ie1HomzqwQ,39c9tXIjuzU,CfB-Qz0G56k
# One-shot backfill after env is set:
#   npm run gated:backfill -- --refresh-privacy
#   npm run videos:sync
#   npm run transcripts:backfill
# Or in Studio: paste IDs into "סמן כמועדון (לא רשום)"


# Club magic-link cookie signing (NeverMind only — never reuse YakirCohen secrets)
# openssl rand -hex 32
CLUB_GATE_SECRET=

# Shared club password: set in Studio at /studio → "סיסמת מועדון משותפת"
# (stored in Supabase club_config, not in env). Apply migration 23_site_presence.sql
# for "מחוברים כרגע" on /studio/users.

# OpenAI (server only). Used for videos.core_facts extraction and for
# /api/search/invert when the Blind Spot map has no premise match.
# Without this key, invert still works for mapped premises (שליטה, חרדה, ...).
# OPENAI_API_KEY=
# OPENAI_CORE_FACTS_MODEL=gpt-4o-mini

# Resend (booking leads, club login notify, viewer feedback)
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# BOOKING_ADMIN_EMAIL=
# Yakir inbox for viewer feedback (falls back to BOOKING_ADMIN_EMAIL)
# RESEND_NOTIFY_EMAIL=

