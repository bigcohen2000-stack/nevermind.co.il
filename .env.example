# NeverMind — copy to .env.local for the isolated Supabase + Vercel project only.
# Never reuse keys from other Cursor projects or other Supabase accounts.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key

# Protects POST /api/admin/sync  (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate_a_long_random_string

# Optional: comma-separated playlist IDs whose videos should be is_gated=true
GATED_PLAYLIST_IDS=

# Optional: YouTube sources for sync (comma-separated)
YOUTUBE_CHANNEL_IDS=
YOUTUBE_PLAYLIST_IDS=
YOUTUBE_UNLISTED_VIDEO_IDS=
YOUTUBE_GATED_VIDEO_IDS=

# WhatsApp booking / lead CTAs (digits only, country code)
NEXT_PUBLIC_WHATSAPP_NUMBER=972555634035

# Optional calendar URL for watch booking modal
NEXT_PUBLIC_SCHEDULE_URL=
