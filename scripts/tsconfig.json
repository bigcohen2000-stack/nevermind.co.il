{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "server-only": ["./empty-server-only.ts"],
      "@/*": ["../src/*"]
    },
    "baseUrl": "."
  },
  "include": ["./**/*.ts", "../src/**/*.ts"]
}
